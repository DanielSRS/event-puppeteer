# Database Configuration
DATABASE_URL=postgres://user:password@localhost:5432/puppeteer

# Authentication
BETTER_AUTH_SECRET=sua-chave-secreta-aqui
BETTER_AUTH_URL=http://localhost:3000

# Server
PORT=3000
NODE_ENV=development

# Superadmin seed (nub run seed:superadmin). Not needed by the server itself.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=troque-esta-senha
