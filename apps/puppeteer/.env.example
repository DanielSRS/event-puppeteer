# Database Configuration
DATABASE_URL=postgres://user:password@localhost:5432/puppeteer
# Optional: connection used by `nub run db:migrate` instead of DATABASE_URL.
# On Supabase: the Session pooler (aws-0-<region>.pooler.supabase.com:5432, user postgres.<ref>).
# Not the direct host db.<ref>.supabase.co: it is IPv6-only and unreachable from most networks and from Vercel
# MIGRATION_DATABASE_URL=

# Authentication
BETTER_AUTH_SECRET=sua-chave-secreta-aqui
BETTER_AUTH_URL=http://localhost:3000

# Email (Brevo transactional API) — verification emails.
# Required in production. Without BREVO_API_KEY in development, emails are printed to the console.
# EMAIL_FROM must be a sender verified in your Brevo account.
BREVO_API_KEY=
EMAIL_FROM=no-reply@uefs-eventos.vercel.app
EMAIL_FROM_NAME="Eventos UEFS"

# Image Screening (docs/adr/0003). Required: the server refuses to start without them.
# Sightengine (free plan: 2,000 operations a month, 500 a day; each Image uses about 4) and
# OpenAI omni-moderation (free) screen every uploaded banner and logo.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
OPENAI_API_KEY=
# Cloudinary stores the Images (as authenticated assets, never public by URL alone).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public URL of the frontend: the verification link redirects to $APP_URL/login?emailVerified=1
APP_URL=http://localhost:3000

# Server
PORT=3000
NODE_ENV=development

# Superadmin seed (nub run db:seed:superadmin). Not needed by the server itself.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=troque-esta-senha
