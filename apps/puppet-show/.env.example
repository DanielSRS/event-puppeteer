# Required. URL of the Puppeteer API. Next proxies /api/* to it (next.config.ts), so the
# browser never calls the API directly and no CORS is needed.
# Local: the API's PORT. Vercel: the API deployment URL, e.g. https://puppeteer-xxx.vercel.app
PUPPETEER_URL=http://localhost:8080

# Required. Public URL of this frontend, encoded in the QR codes (home page and TV display).
# Vercel: e.g. https://puppet-show-xxx.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required. Organization that anonymous visitors see (feed, TV) and that sign-ups join.
# There is no default: the database starts without organizations. Log in as the
# Superadmin, create one in /dashboard/global/orgs and paste its id here.
NEXT_PUBLIC_ORG_ID=

