# URL of the Puppeteer API. Next proxies /api/* to it (next.config.ts), so the
# browser never calls the API directly and no CORS is needed.
# Local: the API's PORT. Vercel: the API deployment URL, e.g. https://puppeteer-xxx.vercel.app
PUPPETEER_URL=http://localhost:8080

# Public URL of this frontend (home page metadata and the TV display).
# Vercel: e.g. https://puppet-show-xxx.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Organization used when none is chosen. Must exist in the database.
NEXT_PUBLIC_ORG_ID=default-org

# Leave unset to go through the /api proxy above (recommended).
# NEXT_PUBLIC_API_URL=
